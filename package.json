{
  "name": "nuxi",
  "version": "0.0.0",
  "type": "module",
  "imports": {
    "#*": "./agent/*",
    "#evals/*": "./evals/*"
  },
  "scripts": {
    "build": "eve build",
    "deploy": "eve deploy",
    "dev": "eve dev",
    "eval": "eve eval",
    "backfill": "tsx --env-file-if-exists=.env.local scripts/backfill.ts",
    "labels": "tsx --env-file-if-exists=.env.local scripts/setup-labels.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed-playground.ts",
    "start": "eve start",
    "typecheck": "tsc",
    "validate-config": "tsx --env-file-if-exists=.env.local scripts/validate-config.ts"
  },
  "dependencies": {
    "@github-tools/eve-extension": "^0.7.1",
    "@github-tools/sdk": "^1.16.1",
    "@upstash/redis": "^1.38.4",
    "@vercel/connect": "2.2.0",
    "ai": "^7.0.105",
    "eve": "^0.58.1",
    "yaml": "^2.9.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
